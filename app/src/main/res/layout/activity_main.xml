<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_drawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/coordinator_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background_primary">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/main_pager"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/background"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- 左上角侧边栏入口 -->
        <ImageView
            android:id="@+id/btn_open_drawer"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="3dp"
            android:background="@drawable/ic_round_bg"
            android:elevation="6dp"
            android:padding="9dp"
            android:src="@drawable/ic_community_menu"
            app:tint="@color/text_primary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:contentDescription="侧边栏" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!--
      悬浮胶囊底部导航栏（build62 参考 kd64i/dyparse 重做）
      · 栏体高 64dp、悬在系统导航栏之上 12dp —— 该间距在 MainActivity 里按
        WindowInsets.navigationBars 动态补偿，手势条 / 三键导航都不会压住
      · 选中指示器是一层独立 View，切页时用 snappy 弹簧滑到目标 Tab（而非直接跳）
      · 各 Tab 有按下缩放反馈，抬手弹簧回弹
    -->
    <FrameLayout
        android:id="@+id/bottom_nav_container"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/nav_bar_bg"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="10dp">

        <!-- 选中指示器（位于 Tab 之下） -->
        <View
            android:id="@+id/nav_indicator"
            android:layout_width="54dp"
            android:layout_height="46dp"
            android:layout_gravity="center_vertical|start"
            android:background="@drawable/nav_indicator_bg" />

        <LinearLayout
            android:id="@+id/nav_items"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp">

            <LinearLayout
                android:id="@+id/nav_home_tab"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="8dp">

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <ImageView
                        android:id="@+id/nav_home_icon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:contentDescription="首页"
                        android:src="@drawable/ic_home"
                        app:tint="@color/nav_icon_default" />
                </FrameLayout>

                <TextView
                    android:id="@+id/nav_home_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="3dp"
                    android:text="@string/tab_home"
                    android:textColor="@color/nav_text_default"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_community_tab"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="8dp">

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <ImageView
                        android:id="@+id/nav_community_icon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:contentDescription="版块"
                        android:src="@drawable/ic_discover"
                        app:tint="@color/nav_icon_default" />
                </FrameLayout>

                <TextView
                    android:id="@+id/nav_community_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="3dp"
                    android:text="@string/tab_community"
                    android:textColor="@color/nav_text_default"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- 中间凸起发布按钮 -->
            <LinearLayout
                android:id="@+id/nav_post_tab"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/nav_post_icon"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="-12dp"
                    android:background="@drawable/bg_nav_center_button"
                    android:contentDescription="@string/action_post"
                    android:elevation="6dp"
                    android:src="@drawable/ic_add"
                    app:tint="@color/white" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_message_tab"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="8dp">

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <ImageView
                        android:id="@+id/nav_message_icon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:contentDescription="消息"
                        android:src="@drawable/ic_message"
                        app:tint="@color/nav_icon_default" />
                    <TextView
                        android:id="@+id/nav_message_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="15dp"
                        android:layout_gravity="top|end"
                        android:layout_marginEnd="-6dp"
                        android:layout_marginTop="-3dp"
                        android:background="@drawable/badge_bg"
                        android:gravity="center"
                        android:minWidth="15dp"
                        android:paddingHorizontal="3dp"
                        android:textColor="@android:color/white"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </FrameLayout>

                <TextView
                    android:id="@+id/nav_message_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="3dp"
                    android:text="@string/tab_message"
                    android:textColor="@color/nav_text_default"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_profile_tab"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="8dp">

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <ImageView
                        android:id="@+id/nav_profile_icon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:contentDescription="个人主页"
                        android:src="@drawable/ic_profile"
                        app:tint="@color/nav_icon_default" />
                </FrameLayout>

                <TextView
                    android:id="@+id/nav_profile_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="3dp"
                    android:text="@string/tab_profile"
                    android:textColor="@color/nav_text_default"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- 左侧功能侧边栏 -->
    <include
        layout="@layout/drawer_main"
        android:layout_width="296dp"
        android:layout_height="match_parent"
        android:layout_gravity="start" />

</androidx.drawerlayout.widget.DrawerLayout>