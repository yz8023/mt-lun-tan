<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/background">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar" android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize" android:background="@color/background"
        app:title="设置" app:titleTextColor="@color/text_primary" app:navigationIconTint="@color/text_primary" />
    <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="@color/divider" />

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">

            <TextView style="@style/SettingsSection" android:text="账号与自动化" />
            <com.google.android.material.card.MaterialCardView style="@style/SettingsCard">
                <LinearLayout android:id="@+id/layout_account_manager" style="@style/SettingsRow" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView style="@style/SettingsTitle" android:text="账号与签到" />
                        <TextView style="@style/SettingsSummary" android:text="多账号管理、一键签到与每日定时任务" />
                    </LinearLayout>
                    <TextView android:id="@+id/tv_account_count" style="@style/SettingsValue" android:text="管理" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView style="@style/SettingsCard">
                <LinearLayout style="@style/SettingsRow">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView style="@style/SettingsTitle" android:text="自动签到" />
                        <TextView style="@style/SettingsSummary" android:text="进入应用时自动检查并补签所有已启用账号" />
                    </LinearLayout>
                    <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switch_auto_sign_in"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" android:contentDescription="自动签到开关"
                        app:thumbTint="@color/switch_thumb_tint" app:trackTint="@color/switch_track_tint" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView style="@style/SettingsSection" android:text="消息与通知" />
            <com.google.android.material.card.MaterialCardView style="@style/SettingsCard">
                <LinearLayout style="@style/SettingsRow">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView style="@style/SettingsTitle" android:text="同帖通知批量已读" />
                        <TextView style="@style/SettingsSummary" android:text="点开一条通知时，同时标记当前列表中同一帖子的通知；默认关闭" />
                    </LinearLayout>
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_same_thread_read"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="同帖通知批量已读开关"
                        app:thumbTint="@color/switch_thumb_tint"
                        app:trackTint="@color/switch_track_tint" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView style="@style/SettingsSection" android:text="外观与阅读" />
            <com.google.android.material.card.MaterialCardView style="@style/SettingsCard">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView style="@style/SettingsTitle" android:text="应用主题" />
                    <LinearLayout android:id="@+id/layout_night_mode" style="@style/SettingsRow" android:layout_marginTop="8dp" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/SettingsItemText" android:text="深色模式" />
                            <TextView style="@style/SettingsSummary" android:text="跟随系统 / 浅色 / 深色" />
                        </LinearLayout>
                        <TextView android:id="@+id/tv_night_mode_value" style="@style/SettingsValue" android:text="跟随系统" />
                    </LinearLayout>
                    <TextView style="@style/SettingsItemText" android:layout_marginTop="8dp" android:text="主题色" />
                    <TextView android:id="@+id/tv_accent_name" style="@style/SettingsSummary" android:text="科技蓝" />
                    <LinearLayout android:id="@+id/ll_accent_swatches" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal" />
                    <LinearLayout android:id="@+id/ll_opacity_sliders" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView style="@style/SettingsSection" android:text="网络、浏览与下载" />
            <com.google.android.material.card.MaterialCardView style="@style/SettingsCard">
                <LinearLayout android:id="@+id/layout_site_verify" style="@style/SettingsRow" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView style="@style/SettingsTitle" android:text="站点验证与登录" />
                        <TextView style="@style/SettingsSummary" android:text="自动使用已保存账号完成验证，并同步浏览器 Cookie" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView style="@style/SettingsCard">
                <LinearLayout android:id="@+id/layout_download_mode" style="@style/SettingsRow" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView style="@style/SettingsTitle" android:text="链接与文件打开方式" />
                        <TextView style="@style/SettingsSummary" android:text="应用内浏览器可复制链接、切换电脑模式或转到系统浏览器" />
                    </LinearLayout>
                    <TextView android:id="@+id/tv_download_mode" style="@style/SettingsValue" android:text="应用内" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView style="@style/SettingsCard">
                <LinearLayout android:id="@+id/layout_browser_ua" style="@style/SettingsRow" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView style="@style/SettingsTitle" android:text="内置浏览器 UA" />
                        <TextView style="@style/SettingsSummary" android:text="仅影响应用内浏览器打开外链，论坛数据请求不变" />
                    </LinearLayout>
                    <TextView android:id="@+id/tv_browser_ua" style="@style/SettingsValue" android:text="内置移动版（默认）" android:maxWidth="160dp" android:ellipsize="end" android:singleLine="true" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView style="@style/SettingsCard">
                <LinearLayout android:id="@+id/layout_reply_prefetch" style="@style/SettingsRow" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView style="@style/SettingsTitle" android:text="评论预加载页数" />
                        <TextView style="@style/SettingsSummary" android:text="进帖子时后台提前取回的评论页数，滑下去不用等；0 为关闭" />
                    </LinearLayout>
                    <TextView android:id="@+id/tv_reply_prefetch" style="@style/SettingsValue" android:text="预加载 3 页" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView style="@style/SettingsCard">
                <LinearLayout android:id="@+id/layout_error_log" style="@style/SettingsRow" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView style="@style/SettingsTitle" android:text="错误日志" />
                        <TextView style="@style/SettingsSummary" android:text="查看、分享或清除崩溃诊断信息" />
                    </LinearLayout>
                    <TextView android:id="@+id/tv_error_log_count" style="@style/SettingsValue" android:text="无" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView style="@style/SettingsCard">
                <Button android:id="@+id/btn_clear_cache" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="清除图片与页面缓存" />
            </com.google.android.material.card.MaterialCardView>

            <TextView style="@style/SettingsSection" android:text="高级工具与集成" />
            <com.google.android.material.card.MaterialCardView style="@style/SettingsCard">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <LinearLayout style="@style/SettingsRow">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/SettingsTitle" android:text="本机只读 MCP" />
                            <TextView android:id="@+id/tv_mcp_summary" style="@style/SettingsSummary" android:text="默认关闭；仅本机回环访问，不含公网隧道" />
                        </LinearLayout>
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switch_mcp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:contentDescription="本机只读 MCP 服务开关"
                            app:thumbTint="@color/switch_thumb_tint"
                            app:trackTint="@color/switch_track_tint" />
                    </LinearLayout>
                    <TextView android:id="@+id/tv_mcp_endpoint" style="@style/SettingsSummary"
                        android:layout_width="match_parent" android:text=""
                        android:visibility="gone" />
                    <LinearLayout android:id="@+id/layout_mcp_token" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="6dp"
                        android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">
                        <TextView style="@style/SettingsItemText" android:text="访问令牌" />
                        <TextView android:id="@+id/tv_mcp_token_value" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_marginStart="10dp"
                            android:layout_weight="1" android:ellipsize="middle" android:fontFamily="monospace"
                            android:maxLines="1" android:text="••••••" android:textColor="@color/text_secondary"
                            android:textIsSelectable="true" android:textSize="12sp" />
                    </LinearLayout>
                    <TextView android:id="@+id/tv_mcp_connection_note" style="@style/SettingsSummary"
                        android:layout_width="match_parent"
                        android:text="电脑端可通过 USB 调试执行 adb forward tcp:9797 tcp:9797，再连接本机端点。"
                        android:visibility="gone" />
                    <Button android:id="@+id/btn_mcp_copy_config" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="8dp"
                        android:text="复制连接配置" android:visibility="gone" />
                    <Button android:id="@+id/btn_mcp_regenerate_token" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:text="重新生成访问令牌"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView style="@style/SettingsSection" android:text="关于与更新" />
            <com.google.android.material.card.MaterialCardView style="@style/SettingsCard">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <LinearLayout style="@style/SettingsRow">
                        <TextView style="@style/SettingsItemText" android:layout_width="0dp" android:layout_weight="1" android:text="应用版本" />
                        <TextView android:id="@+id/tv_version" style="@style/SettingsValue" />
                    </LinearLayout>
                    <LinearLayout style="@style/SettingsRow">
                        <TextView style="@style/SettingsItemText" android:layout_width="0dp" android:layout_weight="1" android:text="论坛地址" />
                        <TextView android:id="@+id/tv_forum_url" style="@style/SettingsValue" android:text="bbs.binmt.cc" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/layout_check_update" style="@style/SettingsRow" android:enabled="false">
                        <TextView style="@style/SettingsItemText" android:layout_width="0dp" android:layout_weight="1" android:text="应用更新" />
                        <TextView android:id="@+id/tv_update_status" style="@style/SettingsValue" android:text="通过 GitHub Release 更新" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
