<?xml version="1.0" encoding="utf-8"?>
<!--
  私信气泡（build61 重做）。

  原来的问题：
  1) 气泡背景直接用 android:background="@color/surface" / "@color/primary"，
     是个直角方块，跟整体圆角卡片风格完全不搭；
  2) maxWidth="280dp" 写在 LinearLayout 上 —— LinearLayout 不支持 maxWidth，
     所以长消息会一路撑出屏幕，文字显示不全；
  3) 头像默认图是 @android:drawable/sym_def_app_icon（系统那只绿色安卓机器人）。

  现在：圆角气泡 drawable + maxWidth 落到 TextView 上 + 头像用应用内占位图，
  时间行也合并成一行放在气泡下方。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="6dp">

    <!-- ===== 对方 ===== -->
    <LinearLayout
        android:id="@+id/chat_left"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_chat_left_avatar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="top"
            android:layout_marginEnd="8dp"
            android:background="@drawable/circle_avatar_bg"
            android:contentDescription="头像"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_account" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_chat_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chat_bubble_left"
                android:lineSpacingExtra="3dp"
                android:maxWidth="250dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="9dp"
                android:textColor="@color/text_primary"
                android:textIsSelectable="true"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_chat_left_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_hint"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tv_chat_left_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:textColor="@color/text_hint"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ===== 自己 ===== -->
    <LinearLayout
        android:id="@+id/chat_right"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_chat_right"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chat_bubble_right"
                android:lineSpacingExtra="3dp"
                android:maxWidth="250dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="9dp"
                android:textColor="@color/text_white"
                android:textIsSelectable="true"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="end"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_chat_right_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_hint"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tv_chat_right_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:textColor="@color/text_hint"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/iv_chat_right_avatar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="top"
            android:layout_marginStart="8dp"
            android:background="@drawable/circle_avatar_bg"
            android:contentDescription="头像"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_account" />
    </LinearLayout>
</LinearLayout>
