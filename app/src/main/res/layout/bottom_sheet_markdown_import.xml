<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="导入 Markdown"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/md_btn_close"
            android:layout_width="44dp"
            android:layout_height="40dp"
            android:contentDescription="关闭 Markdown 导入"
            android:gravity="center"
            android:text="关闭"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/md_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="支持标题、粗斜体、删除线、列表、引用、链接、图片和代码块；已有 BBCode 会保留。"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/md_tab_input"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Markdown 输入"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/md_tab_preview"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="效果预览"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <ScrollView
        android:id="@+id/md_scroll_input"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls">
        <EditText
            android:id="@+id/md_input"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="top|start"
            android:hint="粘贴或输入 Markdown…"
            android:inputType="textMultiLine|textCapSentences"
            android:minHeight="220dp"
            android:padding="12dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:textSize="14sp" />
    </ScrollView>

    <ScrollView
        android:id="@+id/md_scroll_preview"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:background="@color/background_secondary"
        android:fillViewport="true"
        android:padding="12dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/md_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="输入 Markdown 后可预览"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />
    </ScrollView>

    <TextView
        android:id="@+id/md_char_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:paddingTop="4dp"
        android:text="0 字符"
        android:textColor="@color/text_hint"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="end"
        android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/md_btn_copy"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="复制 BBCode"
            android:textSize="12sp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/md_btn_insert"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="插入光标"
            android:textSize="12sp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/md_btn_replace"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="替换正文"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
